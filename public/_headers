# Cache rules for Netlify / Cloudflare Pages / Vercel-style static hosts.
#
# Hashed assets are immutable: their filename changes whenever their content
# changes, so they can be cached forever. index.html must never be cached, or
# visitors keep loading a stale build after you deploy.
#
# BotKeep's static profile serves files as-is and does not read _headers, so
# this file is inert there. Keep it: it costs nothing and makes the build
# portable to hosts that do honour it.

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: no-cache, no-store, must-revalidate

/404.html
  Cache-Control: no-cache

/*
  Cache-Control: public, max-age=3600
